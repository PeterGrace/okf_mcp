  {
    "name": "search",
    "description": "Search concepts across this connection's catalogs (or `catalogs`). Every term of `query` must occur, as a case-insensitive substring, in a concept's title or aliases, tags, description or body; free text matches tags by substring. The `tags` filter matches whole tags only. Returns catalog, path, title, description, a snippet and the concept's size (`lines` and `chars` of the whole file, as a read returns it), best first: check the size before a `get_concept`, since a large concept stays in context once read. With `changeset` (a handle from open_changeset), its catalog is searched through that changeset's drafts, and is listed in `skipped` if they cannot be applied.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "description": "Free text. Every whitespace-separated term must occur\n(case-insensitive substring) in a concept's title or aliases, tags,\ndescription or body; free text matches tags by substring. Empty\nmatches every concept that passes the filters.",
          "type": "string"
        },
        "catalogs": {
          "description": "The catalogs to search (default: this connection's catalogs).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "type": {
          "description": "Only concepts of this `type` (case-insensitive).",
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "description": "Only concepts carrying every one of these tags.\nThese match whole tags only (case-insensitive): `infra` does not\nmatch `infrastructure`, while the same text in `query` would, by\nsubstring.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "status": {
          "description": "Only concepts with this `status` (case-insensitive; a missing status\ncounts as `stable`).",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "At most this many hits (default 20, at most 200; 0 returns none).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "changeset": {
          "description": "Read through this changeset's drafts (its handle); its catalog must be one this call reads.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "CatalogHit": {
          "description": "One hit of a search across catalogs.",
          "type": "object",
          "properties": {
            "catalog": {
              "description": "The catalog holding the concept.",
              "type": "string"
            },
            "path": {
              "description": "`/`-prefixed concept path.",
              "type": "string"
            },
            "title": {
              "description": "The concept's title.",
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "description": "Its description, as written.",
              "type": [
                "string",
                "null"
              ]
            },
            "snippet": {
              "description": "The first body line holding the whole query, else the first holding\nany term, stripped and cut to 160 characters; `None` for an empty\nquery or when no body line matches.",
              "type": [
                "string",
                "null"
              ]
            },
            "lines": {
              "description": "Lines in the concept's whole file, frontmatter included: about what\na `get_concept` or `read_document` of it puts in context. A last line\nwithout a trailing newline counts; an empty file has 0.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "chars": {
              "description": "Characters (Unicode code points, not bytes) in the whole file,\nfrontmatter included, counted with `\\r\\n` line endings read as `\\n`.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "catalog",
            "path",
            "lines",
            "chars"
          ]
        },
        "SkippedCatalog": {
          "description": "A catalog `search` left out, and why.",
          "type": "object",
          "properties": {
            "catalog": {
              "description": "The catalog.",
              "type": "string"
            },
            "error": {
              "description": "The error, as a failed call would report it (`error`, `message`\nand what it concerns)."
            }
          },
          "required": [
            "catalog",
            "error"
          ]
        }
      },
      "required": [
        "hits",
        "skipped"
      ],
      "type": "object",
      "properties": {
        "hits": {
          "description": "Best first: concepts holding the whole query in a better field\nfirst, deprecated concepts last, then catalog order, then path.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogHit"
          }
        },
        "skipped": {
          "description": "Catalogs left out because the `changeset` read through does not\napply over their published files; every other catalog still\nanswered. Empty when every catalog was searched.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkippedCatalog"
          }
        }
      }
    }
  }
]